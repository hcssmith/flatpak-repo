#!/bin/sh
# Regenerate bin/ripgrep/generated-sources.yml from the Cargo.lock of the
# ripgrep release that ripgrep.yml pins, so the vendored crates always
# match the source the module builds (cargo --frozen requires this).
#
# Usage:
#   bin/ripgrep/update-sources [ref]
#
# With no argument the tag is read from ripgrep.yml; pass an explicit ref
# (tag or branch) to preview a bump before editing the manifest. Commit
# Cargo.lock and generated-sources.yml together with the tag change.
set -eu
cd "$(dirname -- "$0")/../.."

REF="${1:-$(sed -n 's/^[[:space:]]*tag:[[:space:]]*//p' bin/ripgrep/ripgrep.yml | head -n 1)}"
if [ -z "$REF" ]; then
  echo "error: no tag: found in bin/ripgrep/ripgrep.yml and no ref given" >&2
  exit 1
fi

echo "Fetching ripgrep Cargo.lock @ $REF" >&2
curl -fsSL "https://raw.githubusercontent.com/BurntSushi/ripgrep/$REF/Cargo.lock" \
  -o bin/ripgrep/Cargo.lock

tools/generate-cargo-sources.sh --yaml bin/ripgrep/Cargo.lock \
  -o bin/ripgrep/generated-sources.yml
